<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vista_blur_background">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/vista_desktop_grid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="24dp"
        app:layout_constraintBottom_toTopOf="@id/vista_taskbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/vista_taskbar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="@drawable/vista_taskbar_background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageButton
            android:id="@+id/vista_start_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/vista_button_background"
            android:contentDescription="@string/start_menu"
            android:src="@android:drawable/ic_menu_manage" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/vista_taskbar_apps"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/vista_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/vista_text_primary" />

        <ImageView
            android:id="@+id/vista_battery"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_dialog_info" />

        <ImageView
            android:id="@+id/vista_wifi"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_upload" />

        <ImageView
            android:id="@+id/vista_volume"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_lock_silent_mode_off" />
    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/vista_start_menu"
        android:layout_width="320dp"
        android:layout_height="420dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/vista_start_menu"
        app:cardCornerRadius="18dp"
        app:layout_constraintBottom_toTopOf="@id/vista_taskbar"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="12dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/vista_start_menu_apps"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/vista_settings_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings" />

            <Button
                android:id="@+id/vista_power_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/close" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/vista_notification_center"
        android:layout_width="300dp"
        android:layout_height="360dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/vista_notification"
        app:cardCornerRadius="18dp"
        app:layout_constraintBottom_toTopOf="@id/vista_taskbar"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/vista_notifications_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp" />
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/vista_search_bar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_margin="24dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/vista_surface_dark"
        app:cardCornerRadius="18dp"
        app:layout_constraintBottom_toTopOf="@id/vista_taskbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <EditText
            android:id="@+id/vista_search_input"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:hint="@string/search"
            android:padding="16dp"
            android:textColor="@color/vista_text_primary"
            android:textColorHint="@color/vista_text_secondary" />
    </androidx.cardview.widget.CardView>

    <!-- NeverSoft Services CRT boot splash (full-screen WebView, fades out after boot) -->
    <WebView
        android:id="@+id/neversoft_splash"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/black"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
